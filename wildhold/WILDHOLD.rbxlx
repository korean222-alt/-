        <Item class="ModuleScript" referent="RBX000011">
          <Properties>
            <string name="Name">MapConfig</string>
            <ProtectedString name="Source">-- 초원 맵 배치. 좌표는 stud, 기지 중심(Core) = (0, 0).
-- 길목 방향: 1 = 북(-Z), 2 = 남동, 3 = 남서. 진입로 사이 부채꼴에 자원·야생 펫이 있다.
