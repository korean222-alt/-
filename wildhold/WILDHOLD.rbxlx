            <string name="Name">AudioConfig</string>
            <ProtectedString name="Source">-- 효과음 자산 ID. 비어 있으면 Roblox 내장 기본 소리를 쓴다 (AudioController).
-- 형식: "rbxassetid://123456789"  (docs/내가_할_일.md 3번 참고)
return {
	Volume = 0.35,
	Attack = "", -- 창 찌르기 · 채집
	Arrow = "", -- 포탑 화살
	Build = "", -- 건설 · 수리
	Capture = "", -- 포획 성공
	Fail = "", -- 포획 실패
	Secured = "", -- 영구 확정
	Night = "", -- 밤 시작
	Click = "", -- UI 버튼
}
</ProtectedString>
