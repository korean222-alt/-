+-- ★ Phase 38.4 : 튜토리얼 판에 앉아 있는 동안에는 스페이스 · 점프 버튼으로 의자에서 일어나지 않는다.
+--   환영 창이 "클릭(스페이스)해서 잡아요"라고 가르치는데, 스페이스는 잡는 순간(Phase4Controller 의 의자 잠금)에만 막혀 있었다.
+--   해적이 나오기 전 · 잡은 뒤 · AI 차례에 스페이스(휴대폰은 점프 버튼)를 누르면 일어나서 튜토리얼 판이 기권으로 끝났고,
+--   몇 초 뒤 다시 앉혀져 보통 해적부터 다시 했다. 튜토리얼을 마치거나 건너뛰면 풀린다.
+--   (서버가 일으켜 세우는 것 : 건너뛰기 · 탈락은 humanoid.Sit = false 라 그대로 된다)
+local HOLD_ACTION = "CursedBarrel_TutorialSeatHold"
+local holding = false
+local heldHumanoid = nil
+local function setSeatHold(on)
+	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
+	if on and humanoid then
+		-- 잡기가 끝날 때 의자 잠금이 점프를 다시 켜도 여기서 곧바로 다시 끈다
+		if humanoid:GetStateEnabled(Enum.HumanoidStateType.Jumping) then
+			humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
+		end
+		heldHumanoid = humanoid
+	end
+	if on == holding then
+		return
+	end
+	holding = on
+	player:SetAttribute("TutorialSeatHold", on or nil) -- Phase4Controller 의 의자 잠금이 이것을 보고 점프를 켜지 않는다
+	if on then
+		-- 잡는 동안에는 더 높은 순위의 의자 잠금(Phase4Controller)이 스페이스를 잡기로 받는다
+		ContextActionService:BindActionAtPriority(HOLD_ACTION, function()
+			return Enum.ContextActionResult.Sink
+		end, false, Enum.ContextActionPriority.High.Value + 50, Enum.KeyCode.Space)
+	else
+		ContextActionService:UnbindAction(HOLD_ACTION)
+		if heldHumanoid and heldHumanoid.Parent then
+			heldHumanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
+		end
+		heldHumanoid = nil
+	end
+end
