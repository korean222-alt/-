+local function quitPhase(player)
+	if player:GetAttribute("TutorialWelcome") == true then
+		return "welcome", 0, ""
+	end
+	for _, gameTable in ipairs(TableService:GetAllTables()) do
+		local model = gameTable.model
+		if model and model:GetAttribute(TABLE_ATTR.Tutorial) == player.UserId then
+			local step = tonumber(model:GetAttribute("TutorialStep")) or 0
+			if step <= 0 then
+				return "starting", 0, ""
+			end
+			return "playing", step, tostring((TUTORIAL.Kinds or {})[step] or "")
+		end
+	end
+	return "finding", 0, ""
+end
