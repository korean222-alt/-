+--------------------------------------------------
+-- Phase 38.3 : 크라켄 몸통
+--   예전에는 빛나는 약점 · 눈 · 치켜든 다리 끝만 맞았다. 그래서 갑판에 드러누운 큰 다리, 물 위의 머리,
+--   갑판을 내려친 다리를 쏘면 전부 "빗나갔다"였다 ("크라켄이 안 맞아").
+--   이제 몸통 어디든 맞으면 명중이다. 약점 · 눈 · 막기는 여전히 더 아프다 (먼저 본다).
+--------------------------------------------------
+T.BodySamples = 14
+T.BodyMargin = 1.2 -- 화면의 다리(부드럽게 옮겨 가는 날뜀 · 말린 끝)와 판정의 작은 차이를 덮는다
+
+local function slamBodyRadius(u)
+	return 0.6 + (3.6 - 0.6) * (1 - u) ^ 1.1 -- KrakenController 의 내려치는 다리 굵기와 같다
+end
+
+local restingCache = nil
+local function restingBodies()
+	if not restingCache then
+		restingCache = {}
+		for index, spec in ipairs(K.Resting or {}) do
+			local ok, samples = pcall(K.restingSample, spec, T.BodySamples + 6)
+			restingCache[index] = ok and samples or {}
+		end
+	end
+	return restingCache
+end
+
+--[[
+	광선이 크라켄 몸통에 처음 닿는 곳. 바다 속(물 아래)은 치지 않는다.
+	돌려주는 값 : { kind = "arm"(움직이는 다리 · index) | "head" | "body"(누운 다리 · 내려친 다리), index, point, distance } 또는 nil
+]]
+function T.bodyHit(origin, dir, t, opts)
+	opts = opts or {}
+	local range = opts.range or 200
+	local margin = opts.bodyMargin or T.BodyMargin
+	local floorY = K.SeaY - 0.3
+	local best = nil
+	local function consider(kind, index, center, radius)
+		local d = T.rayDistance(origin, dir, center, radius)
+		if d and d <= range and (not best or d < best.distance) then
+			local point = origin + dir * d
+			if point.Y >= floorY then
+				best = { kind = kind, index = index, point = point, distance = d, center = center }
+			end
+		end
+	end
+	for index, spec in ipairs(K.Arms) do
+		for _, s in ipairs(K.sample(spec, t, T.BodySamples, opts.amp)) do
+			if s.p.Y + s.r > floorY then
+				consider("arm", index, s.p, s.r + margin)
+			end
+		end
+	end
+	for index, samples in ipairs(restingBodies()) do
+		for _, s in ipairs(samples) do
+			consider("body", index, s.p, s.r + margin)
+		end
+	end
+	local center = T.headBasis(t, opts.rise)
+	consider("head", 0, center, K.Head.mantle * 0.5)
+	for _, slam in ipairs(opts.slams or {}) do
+		local tip = T.slamTip(slam, t)
+		if tip then
+			local count = 10
+			for i, p in ipairs(T.slamSpine(slam, tip, count)) do
+				consider("body", slam.id, p, slamBodyRadius((i - 1) / (count - 1)) + margin)
+			end
+		end
+	end
+	return best
+end
+
