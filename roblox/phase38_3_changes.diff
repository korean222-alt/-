-	opts = { amp, rise, slams = {slam...}, armRadius, eyeRadius, slamRadius, range }
-	돌려주는 값 : { kind = "arm"|"eye"|"slam", index, slam, point, distance } 또는 nil
+	opts = { amp, rise, slams = {slam...}, armRadius, eyeRadius, slamRadius, range, body }
+	돌려주는 값 : { kind = "arm"|"eye"|"slam"|"head"|"body", index, slam, point, distance } 또는 nil
+	  약점 · 눈 · 치켜든 다리 끝을 먼저 보고, 없으면 몸통 (opts.body == false 면 몸통은 보지 않는다)
 ]]
