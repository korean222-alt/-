+-- Phase 38.3 : 대포 쏘는 자세. 두 팔을 앞으로 뻗어 포신을 잡고 몸을 앞으로 숙인다 (on) · 풀기 (off)
+--   관절 C0 는 복제되지 않으므로 모든 화면(CannonController)이 대포를 잡은 사람(CannonId)마다 각자 입힌다
+local cannonState = setmetatable({}, { __mode = "k" }) -- [character] = true
+local CANNON_ARM, CANNON_SPREAD, CANNON_LEAN = 78, -10, 14
+function StabMotion.cannonPose(character, on)
+	local set = joints(character)
+	if not set then
+		return
+	end
+	if on == (cannonState[character] == true) then
+		return
+	end
+	cannonState[character] = on or nil
+	local info = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
+	local function go(joint, goal)
+		if joint and goal and joint.Parent then
+			TweenService:Create(joint, info, { C0 = goal }):Play()
+		end
+	end
+	if on then
+		go(armPose(set, "right", CANNON_ARM, CANNON_SPREAD))
+		go(armPose(set, "left", CANNON_ARM, CANNON_SPREAD))
+		go(waistPose(set, CANNON_LEAN, 0))
+	else
+		for _, joint in ipairs({ set.right, set.left, set.waist }) do
+			if joint and joint.Parent then
+				go(joint, home(joint))
+			end
+		end
+	end
+end
+
+-- 쏠 때마다 반동 : 팔이 튀어 오르고 몸이 뒤로 젖혀졌다가 다시 쏘는 자세로
+function StabMotion.cannonKick(character)
+	local set = joints(character)
+	if not set or not cannonState[character] then
+		return
+	end
+	local kick = TweenInfo.new(0.06, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
+	local settle = TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
+	local function go(info, joint, goal)
+		if joint and goal and joint.Parent then
+			TweenService:Create(joint, info, { C0 = goal }):Play()
+		end
+	end
+	go(kick, armPose(set, "right", CANNON_ARM + 26, CANNON_SPREAD))
+	go(kick, armPose(set, "left", CANNON_ARM + 26, CANNON_SPREAD))
+	go(kick, waistPose(set, -8, 0))
+	task.delay(0.1, function()
+		if cannonState[character] then
+			go(settle, armPose(set, "right", CANNON_ARM, CANNON_SPREAD))
+			go(settle, armPose(set, "left", CANNON_ARM, CANNON_SPREAD))
+			go(settle, waistPose(set, CANNON_LEAN, 0))
+		end
+	end)
+end
