+-- Phase 38.3 : 어려운 카드는 라운드가 오를수록 세진다. card.ramp = { key, from, to, per }
+--   카드가 풀리는 라운드(minStage)에 from, 그 뒤 라운드마다 per 만큼 to 쪽으로 (to 를 넘지 않는다).
+--   ramp 가 없는 항목은 카드에 적힌 값 그대로. 값이 없으면 nil
+function GameConfig.fateCardValue(card, key, stage)
+	if not card then
+		return nil
+	end
+	local ramp = card.ramp
+	if ramp and ramp.key == key then
+		local steps = math.max(0, math.floor(tonumber(stage) or 1) - (card.minStage or 1))
+		local from, to = tonumber(ramp.from) or 1, tonumber(ramp.to) or 1
+		local moved = (tonumber(ramp.per) or 0) * steps
+		if to < from then
+			return math.max(to, from - moved)
+		end
+		return math.min(to, from + moved)
+	end
+	return tonumber(card[key])
+end
+
+-- 이 라운드에서 보여 줄 카드 설명 (ramp 가 있는 카드는 지금 세기를 % 로 적는다)
+function GameConfig.fateCardText(card, stage)
+	if not card then
+		return ""
+	end
+	if card.textFormat and card.ramp then
+		local value = GameConfig.fateCardValue(card, card.ramp.key, stage) or 1
+		return card.textFormat:format(math.floor(math.abs(1 - value) * 100 + 0.5))
+	end
+	return card.text or ""
+end
